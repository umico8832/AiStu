# Development default: reuse the signed-in local Codex CLI.
KALEIDOSCOPE_AI_PROVIDER=codex

# Optional when the packaged app cannot resolve `codex` from PATH.
# Set this at launch time with: KALEIDOSCOPE_CODEX_PATH="$(command -v codex)"
KALEIDOSCOPE_CODEX_PATH=

# Optional bounded response timeout, clamped to 15–600 seconds.
KALEIDOSCOPE_CODEX_TIMEOUT_MS=180000

# Optional explicit path to the independent ODS knowledge_base directory.
# Development also searches for a sibling ods-material/knowledge_base directory.
KALEIDOSCOPE_KNOWLEDGE_BASE_PATH=

# Deterministic, offline test mode:
# KALEIDOSCOPE_AI_PROVIDER=demo
