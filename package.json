{
  "name": "kaleidoscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop AI teaching workspace with safe, registered interactive visualizations.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.21.0 <23 || >=24.14.0 <25",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @kaleidoscope/desktop dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "docs:check": "node scripts/check-docs.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:golden": "playwright test e2e/golden-flow.spec.ts",
    "test:e2e:sidebar": "pnpm --filter @kaleidoscope/desktop build && playwright test e2e/navigation-sidebar.spec.ts",
    "build": "pnpm -r --if-present build",
    "package": "pnpm sync:knowledge && pnpm --filter @kaleidoscope/desktop package",
    "package:dir": "pnpm sync:knowledge && pnpm --filter @kaleidoscope/desktop package:dir",
    "sync:knowledge": "node scripts/sync-knowledge-snapshot.cjs",
    "check:knowledge-snapshot": "node scripts/sync-knowledge-snapshot.cjs --check",
    "setup:knowledge": "python3 -m venv content/ods-material/knowledge_base/.venv && content/ods-material/knowledge_base/.venv/bin/python -m pip install -r content/ods-material/knowledge_base/requirements.txt",
    "test:knowledge": "PYTHONPATH=content/ods-material content/ods-material/knowledge_base/.venv/bin/python -m pytest content/ods-material/knowledge_base/tests",
    "validate:knowledge": "PYTHONPATH=content/ods-material content/ods-material/knowledge_base/.venv/bin/python -m knowledge_base.scripts.kb_pipeline --root content/ods-material validate",
    "verify:mac-package": "node scripts/verify-macos-package.cjs",
    "smoke:mac-package": "node scripts/smoke-macos-package.cjs",
    "acceptance:mac": "pnpm test:knowledge && pnpm validate:knowledge && pnpm sync:knowledge && pnpm docs:check && pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e && pnpm package:dir && pnpm verify:mac-package && pnpm smoke:mac-package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "happy-dom": "20.11.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
