{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aistu-kb/taxonomy-2.0.0",
  "title": "AiStu standard knowledge-base course taxonomies",
  "type": "object",
  "required": ["version", "courses"],
  "properties": {
    "version": {"const": 2},
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["course_id", "title", "chapters"],
        "properties": {
          "course_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "title_zh": {"type": "string"},
          "source_edition": {"type": "string"},
          "chapters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "order", "sections"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "title": {"type": "string", "minLength": 1},
                "title_zh": {"type": "string"},
                "order": {"type": "integer", "minimum": 0},
                "source_chapter_number": {"type": ["integer", "null"]},
                "sections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "title", "order"],
                    "properties": {
                      "id": {"type": "string", "minLength": 1},
                      "title": {"type": "string", "minLength": 1},
                      "title_zh": {"type": "string"},
                      "order": {"type": "integer", "minimum": 1},
                      "source_section_number": {"type": ["string", "null"]},
                      "subsections": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["id", "title", "order"],
                          "properties": {
                            "id": {"type": "string", "minLength": 1},
                            "title": {"type": "string", "minLength": 1},
                            "title_zh": {"type": "string"},
                            "order": {"type": "integer", "minimum": 1},
                            "source_subsection_number": {"type": ["string", "null"]},
                            "concept_ids": {
                              "type": "array",
                              "items": {"type": "string"}
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "concept_ids": {
                        "type": "array",
                        "items": {"type": "string"}
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
